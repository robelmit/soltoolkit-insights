{
  "name": "@soltoolkit/holder-map-react",
  "version": "0.1.0",
  "description": "A React viewer for a token's holder map: one bubble for each holder, sized by share, coloured by cluster, with the links between them. Renders on a server, with a legend, a tooltip and a table of the same data.",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/robelmit/soltoolkit-insights.git",
    "directory": "packages/holder-map-react"
  },
  "homepage": "https://github.com/robelmit/soltoolkit-insights/tree/main/packages/holder-map-react#readme",
  "bugs": {
    "url": "https://github.com/robelmit/soltoolkit-insights/issues"
  },
  "keywords": [
    "solana",
    "holders",
    "bubble-map",
    "react",
    "visualization"
  ],
  "type": "module",
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "import": {
        "types": "./dist/index.d.ts",
        "default": "./dist/index.js"
      },
      "require": {
        "types": "./dist/index.d.cts",
        "default": "./dist/index.cjs"
      }
    },
    "./layout": {
      "import": {
        "types": "./dist/layout.d.ts",
        "default": "./dist/layout.js"
      },
      "require": {
        "types": "./dist/layout.d.cts",
        "default": "./dist/layout.cjs"
      }
    }
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ],
  "sideEffects": false,
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "build": "rimraf dist && tsup",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "clean": "rimraf dist .turbo"
  },
  "peerDependencies": {
    "react": ">=18"
  },
  "devDependencies": {
    "@soltoolkit/holder-map": "workspace:^",
    "@testing-library/react": "^16.1.0",
    "@types/node": "^22.10.2",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "jsdom": "^25.0.1",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "rimraf": "^6.0.1",
    "tsup": "^8.4.0",
    "typescript": "^5.7.2",
    "vitest": "^2.1.8"
  },
  "publishConfig": {
    "access": "public"
  }
}
